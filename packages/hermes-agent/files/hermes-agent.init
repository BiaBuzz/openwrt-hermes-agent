#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/hermes-agent
LOG_FILE=/tmp/hermes-agent.log

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/hermes-runner
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile /var/run/hermes-agent.pid
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "hermes"
}
